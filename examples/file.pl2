// include "std/io"

fn strlen(s *i8) i64 {
    if s == 0 {
        return 0;
    }

    let i i64 = 0;
    while (s[i] != 0) {
        i = i + 1;
    }

    return i;
}

fn write(fd i32, contents *i8, size i64) i64 {
@output("
    load 0   ; fd
    load.d 1 ; ptr
    load.d 3 ; size
    push 4   ; write
    system
    ret.w
    ; unreachable:
");

    return 0;
}

fn printn(string *i8, size i64) i32 {
@output("
    push 1 ; stdout
    load.d 0
    load.d 2
    push 4 ; write
    system
    ret.w
    ; unreachable:
");

    return 0;
}

fn print(string *i8) i32 {
    printn(string, strlen(string));

    return 0;
}

// FIXME: no return type -> function returns value -> assertion error

fn open(filepath *i8, flags i32, mode i32) i32 {
    let len = strlen(filepath); // local = 4

@output("
    load.d 0 ; path ptr
    load.d 4 ; path size
    load 2   ; flags
    load 3   ; mode
    push 5   ; open
    system
    ret.w
    ; unreachable:
");

    return 0;
}

fn exit(code i32) {
    @output("");

    return;
}

fn main(argc i32, argv **i8) {

    let i i64 = 0;
    while (cast(i32) i < argc) {
        printn(argv[i], strlen(argv[i]));
        print("\n");
        i = i + 1;
    }

    let path = "my_file.txt";

    // TODO: constants and bitwise operations
    let o_rdwr_creat = 514;
    let rw_u_g = 432;
    let fd = open(path, o_rdwr_creat, rw_u_g);
    if (fd < 0) {
        print("could not open file\n");
        return;
    }

    let contents = "file contents\n";
    let n = write(fd, contents, strlen(contents));
    if (n < 0) {
        print("could not write to file");
        return;
    }


    return;
}
